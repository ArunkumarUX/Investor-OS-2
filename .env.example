# Copy to .env.local. Never commit actual credentials.
OPENAI_COMPAT_BASE_URL=https://your-workspace-host/compatible-mode/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=qwen-plus
AI_TIMEOUT_MS=45000
# Optional alternative providers:
# Set AI_PROVIDER=anthropic to prefer Anthropic explicitly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Local monitor target:
INVEST_OS_URL=http://localhost:3333
# Isolated testing only; leave unset for the normal workspace:
# INVEST_OS_DATA_FILE=/tmp/invest-os-disposable-test.json
# Destructive reset is disabled unless explicitly enabled:
# INVEST_OS_ENABLE_RESET=1
